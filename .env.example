# Stripe keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the Stripe webhook (Developers > Webhooks) pointed at /api/stripe/webhook with the
# checkout.session.completed event. Delivery orders get their driver booked when it fires.
STRIPE_WEBHOOK_SECRET=whsec_...
# Delivery courier: doordash, uber, or stub (pretend courier for testing). Leave empty for pickup only.
DELIVERY_COURIER=
# DoorDash Drive access key from https://developer.doordash.com (Credentials)
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
# Uber Direct keys from https://direct.uber.com (Developer)
UBER_CUSTOMER_ID=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# Postgres address for staff accounts, e.g. a free Neon database (Vercel: Storage > Neon). Tables are created on first use.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Hash of the owner's Owner ID. Make both with `npm run owner-code`; give the owner the ID and set only the hash here.
OWNER_CODE_HASH=
# Public URL of the site, used for Stripe redirect URLs and link previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
