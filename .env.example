# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/business_builder

# Public URL of the site (used for Stripe redirects and email links)
APP_URL=http://localhost:3000

# Stripe: the subscription price that unlocks the AI assistant
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Claude API
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Deadline reminder emails (Resend)
RESEND_API_KEY=
EMAIL_FROM="The Business Builder <alerts@thebusinessbuilder.tech>"

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
